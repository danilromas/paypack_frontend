# Copy to .env (kept out of git) — Neon dashboard → Connection string.
# Not used when running via `docker compose up` — compose points DATABASE_URL at
# the local Postgres container instead (see docker-compose.yml).
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require"

# Random 32+ byte secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="<generate-a-random-secret>"

# Resend (https://resend.com) — used for password-reset emails in production.
# Leave unset locally: docker-compose routes mail to Maildev instead (http://localhost:1080),
# and without Docker, unset falls back to printing the reset link to the server console.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="PayPack <onboarding@resend.dev>"

# Base URL used to build links inside emails (password reset, etc).
APP_URL="http://localhost:3000"

# Sendcloud (https://app.sendcloud.com → Settings → Integrations → Sendcloud API) — books real
# carrier labels for senders in SENDCLOUD_SENDER_COUNTRIES; Eurosender serves everyone else.
# Webhook URL to configure on the integration: https://<host>/api/webhooks/sendcloud/
SENDCLOUD_PUBLIC_KEY=""
SENDCLOUD_SECRET_KEY=""
# The "Webhook Signature Key" you set on the integration (falls back to the secret key when empty).
SENDCLOUD_WEBHOOK_SIGNATURE_KEY=""
SENDCLOUD_SENDER_COUNTRIES="IT"
# "true" books every shipment as Sendcloud's free "Unstamped letter" test label (never charged/collected).
SENDCLOUD_TEST_MODE=""
